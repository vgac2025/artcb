run = "bash scripts/replit_start.sh"
language = "python3"
entrypoint = "src/api/main.py"

[nix]
channel = "stable-23_11"

[env]
PYTHONPATH = "/home/runner/${REPL_SLUG}"
ARTCB_DEBUG = "true"
ARTCB_DATA_DIR = "/home/runner/${REPL_SLUG}/data"
ARTCB_LOG_DIR = "/home/runner/${REPL_SLUG}/logs"
ARTCB_ENCODE_MODE = "rule-based"
ARTCB_LLM_ENABLED = "false"
ARTCB_ANTI_SYBIL_AI_BYPASS = "true"

[deployment]
# Port 5000 : requis pour Replit webview (pas 8000)
# Venv créé au build, utilisé au run
build = ["sh", "-c", "python3 -m venv $HOME/venv && $HOME/venv/bin/pip install -r requirements.txt -q"]
run = ["sh", "-c", "PYTHONPATH=/home/runner/${REPL_SLUG} $HOME/venv/bin/python3 -m uvicorn src.api.main:app --host 0.0.0.0 --port 5000"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 5000
externalPort = 80
