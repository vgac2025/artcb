run = "bash scripts/replit_start.sh"
language = "python3"
entrypoint = "src/api/main.py"
modules = ["python-3.11", "nodejs-20", "bash", "web"]

[nix]
channel = "stable-25_05"

[env]
PYTHONPATH = "/home/runner/${REPL_SLUG}"
ARTCB_DEBUG = "true"
ARTCB_DATA_DIR = "/home/runner/${REPL_SLUG}/data"
ARTCB_LOG_DIR = "/home/runner/${REPL_SLUG}/logs"
ARTCB_ENCODE_MODE = "rule-based"
ARTCB_LLM_ENABLED = "false"
ARTCB_ANTI_SYBIL_AI_BYPASS = "true"

[deployment]
# Port 5000 : requis pour Replit webview (pas 8000)
# NOTE Autoscale : build et run = conteneurs DISTINCTS → venv du build absent au run
# Solution : run recrée son propre venv (cache pip = rapide après 1er déploiement)
run = ["sh", "-c", "python3 -m venv $HOME/venv && $HOME/venv/bin/pip install -r requirements.txt -q && PYTHONPATH=/home/runner/${REPL_SLUG} $HOME/venv/bin/python3 -m uvicorn src.api.main:app --host 0.0.0.0 --port 5000"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 5000
externalPort = 80
