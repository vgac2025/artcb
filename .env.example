# ARTCB — copy to .env: cp ENV_A_REMPLIR_ARTCB .env (NEVER commit .env)

ARTCB_DEBUG=true
ARTCB_LOG_LEVEL=DEBUG
ARTCB_LOG_DIR=./logs
ARTCB_REPORTS_DIR=./rapports
ARTCB_DATA_DIR=./data
ARTCB_HOST=127.0.0.1
ARTCB_PORT=8000
ARTCB_ENCODE_MODE=rule-based
ARTCB_LLM_ENABLED=false
ARTCB_POL_ALPHA=0.4
ARTCB_POL_BETA=0.3
ARTCB_POL_GAMMA=0.3
ARTCB_POL_THRESHOLD=0.6
ARTCB_DEMO_BOOK_PDF=data/fixtures/wailly_le_roi_de_l_inconnu.pdf
ARTCB_NETWORK=local

# Optional — paste your keys (see ENV_A_REMPLIR_ARTCB for French guide)
# BOB_API_KEY=
# OPENROUTER_API_KEY=
# BOB_API_BASE=https://api.us-east.bob.ibm.com
# BOB_MODEL=ibm/granite-3-8b-instruct
# BOB_TEAM_ID=
# BOB_INSTANCE_ID=
# GRADIUM_API_KEY=
# GRADIUM_API_URL=https://api.gradium.ai
# GITHUB_TOKEN=

# ── Anti-Sybil — configuration dynamique ──────────────────────────────
# Intervalle minimum entre 2 blocs du même wallet (défaut: 60s)
ARTCB_MIN_BLOCK_INTERVAL_SEC=60
# Bypass rate-limit pour blocs IA (ai_memo/ai_think) — true=étude, false=prod
ARTCB_ANTI_SYBIL_AI_BYPASS=false
# Mode étude global — rien rejeté pour rate-limit (PoL min + blacklist actifs)
ARTCB_ANTI_SYBIL_STUDY_MODE=false

# ── WatsonX IBM — paramètres requis ───────────────────────────────────
# IAM fonctionne ; project_id requis pour les requêtes LLM
# WATSONX_API_KEY=
# WATSONX_URL=https://eu-de.ml.cloud.ibm.com
# WATSONX_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Bridges blockchain — interopérabilité Phase 12.2 ──────────────────
#
# Bitcoin : GRATUIT, aucune clé requise (mempool.space)
BITCOIN_API_URL=https://mempool.space/api
#
# Ethereum : remplacer par ton URL Infura/Alchemy pour éviter le rate-limit Cloudflare
# Obtenir clé Infura : https://infura.io (gratuit, 100K req/j)
#   → Create Project → Copy "Mainnet" endpoint
# Obtenir clé Alchemy : https://alchemy.com (gratuit, 300M unités/mois)
#   → Create App → Copy HTTPS URL
# ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/TON_PROJECT_ID
# ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/TON_API_KEY
ETHEREUM_RPC_URL=https://cloudflare-eth.com
#
# BNB Chain : endpoint public gratuit, pas de clé
BNB_RPC_URL=https://bsc.publicnode.com
#
# Polygon : endpoint public gratuit
POLYGON_RPC_URL=https://polygon-rpc.com
#
# Avalanche C-Chain : endpoint public gratuit
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
#
# Solana : endpoint public gratuit
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
#
# IP publique de ce nœud ARTCB (pour le gossip P2P multi-nœuds)
# Sans cette variable, le nœud s'annonce comme 127.0.0.1 (inaccessible depuis l'extérieur)
# ARTCB_PUBLIC_HOST=51.255.22.253
#
# URL Ollama si installé sur une machine distante
# ARTCB_OLLAMA_URL=http://192.168.1.10:11434
